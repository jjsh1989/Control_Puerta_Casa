# Copia de ejemplo de .env (el de verdad lo crea ./instalar.sh y NO se sube a git)
TZ=Europe/Madrid
# Puerto del panel dentro del servidor (solo escucha en 127.0.0.1)
PANEL_PUERTO_HOST=8790
# Nombres extra con los que se puede entrar al panel, separados por comas (opcional)
PANEL_HOSTS=
# Imagen de WhatsApp con versión fija (la probada). En ARM: devlikeapro/waha:noweb-arm
# Para actualizar, cambia el sha256 por el de la versión nueva después de probarla.
WAHA_IMAGEN=devlikeapro/waha:noweb@sha256:0d64cce14a922f61bb9a620474086d1f5695f2522e7e1088704e6eca3a085d0c
# Clave aleatoria entre el panel y WAHA (instalar.sh la genera)
WAHA_API_KEY=cambia-esto
# Dirección pública del panel, para los enlaces de los avisos (./instalar.sh tailscale la rellena)
PANEL_URL_PUBLICA=https://puerta.tu-red.ts.net
# Opcional: IP de las cámaras/base Eufy en tu red, si el puente no las encuentra solo
# EUFY_IP_CAMARAS=
